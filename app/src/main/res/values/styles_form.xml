<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Form_Button">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">24sp</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="Form_Button_Segunda_Opcion" parent="Form_Button">
        <item name="backgroundTint">@color/terciario</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Form_InputOutline" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">4dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="android:layout_margin">10dp</item>
    </style>

    <style name="Form_InputBusqueda_Outline" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">4dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="android:layout_marginVertical">20dp</item>
    </style>

    <style name="Form_Button_Incio_Entrenamiento">
        <item name="borderRound">5dp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16dp</item>
    </style>

    <style name="Form_Button_Flotante_texto">
        <item name="borderRound">5dp</item>
        <item name="backgroundTint">@color/primario</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16dp</item>
    </style>

    <style name="Form_Button_Categoria_Parte_Anatomica">
        <item name="android:padding">15dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/terciario</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Form_Button_Categoria_Ejercicio">
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">30dp</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:gravity">center</item>
    </style>
    
    <style name="Form_Button_Eliminar">
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textColor">@color/rojo</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/rojo</item>
        <item name="backgroundTint">@color/terciario</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>