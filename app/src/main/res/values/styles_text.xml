<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Texto_Titulo">
        <item name="android:textColor">@color/primario</item>
        <item name="android:lineHeight">60sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">60sp</item>
        <item name="android:fontFamily">@font/oswald_bold</item>
    </style>

    <style name="Texto_SubTitulo">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Texto_Contenido">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Texto_HiperVinculo">
        <item name="android:textColor">@color/primario</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>