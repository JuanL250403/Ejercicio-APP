<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/Layout_Main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.Inicio">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card_Inicio_Entrenamiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="2">

                <LinearLayout
                    style="@style/Layout_Card_Inicio_Entrenamiento"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto_Titulo_Resaltado_Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="left|center"
                        android:text="@string/rutina_hoy" />

                    <TextView
                        style="@style/Texto_Descripcion_Entrenamiento_Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text="@string/sin_rutina_hoy"/>

                    <Button
                        android:visibility="gone"
                        style="@style/Form_Button_Incio_Entrenamiento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/iniciar_entrenamiento" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card_Inicio_Opcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <GridLayout
                    style="@style/Layout_Card_Inicio_Opcion"
                    android:layout_width="match_parent"
                    android:columnCount="2"
                    android:rowCount="1"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_row="0"
                        android:layout_gravity="center"
                        android:layout_height="wrap_content">
                        <ImageView
                            style="@style/imagen_opcion_inicio"
                            android:src="@drawable/ic_calendario" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_row="0"
                        android:layout_column="1"
                        android:layout_gravity="center"
                        style="@style/Texto_Descripcion_Opcion_Card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/calendario" />

                </GridLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card_Inicio_Opcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <GridLayout
                    android:columnCount="2"
                    android:rowCount="1"
                    style="@style/Layout_Card_Inicio_Opcion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_column="0"
                        android:layout_gravity="center"
                        >

                        <ImageView
                            style="@style/imagen_opcion_inicio"
                            android:src="@drawable/ic_pesa" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_column="1"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        style="@style/Texto_Descripcion_Opcion_Card"
                        android:layout_height="wrap_content"
                        android:text="@string/gestion_rutinas" />

                </GridLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card_Inicio_Opcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <GridLayout
                    style="@style/Layout_Card_Inicio_Opcion"
                    android:layout_width="match_parent"
                    android:rowCount="1"
                    android:columnCount="2"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/imagen_opcion_inicio"
                            android:src="@drawable/ic_historial" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_gravity="center"
                        style="@style/Texto_Descripcion_Opcion_Card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/historial"
                        android:textAlignment="center" />

                </GridLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>