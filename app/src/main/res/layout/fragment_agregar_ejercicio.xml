<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.AgregarEjercicioFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                style="@style/Layout_Main"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreEjercicio"
                    style="@style/Texto_Titulo_Pantalla"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/llContenedorDatos"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:gravity="center"
                    android:layout_below="@id/ivEjercicio"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- COLUMNA IZQUIERDA (Series y Peso) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"

                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Bloque Series -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ltSeries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/series_layout">

                            <EditText
                                android:id="@+id/etSeries"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Bloque Series -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ltDescanso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/descanso_layout">

                            <EditText
                                android:id="@+id/etDescanso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- COLUMNA DERECHA (Reps y Descanso) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Bloque Series -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ltReps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/repeticiones_layout">

                            <EditText
                                android:id="@+id/etReps"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Bloque Series -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ltPeso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/peso_layout">

                            <EditText
                                android:id="@+id/etPeso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Layout_Card_Instrucciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:minHeight="300dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.google.android.material.imageview.ShapeableImageView
                                app:shapeAppearanceOverlay="@style/Layout_img_redondeada"
                                android:id="@+id/ivVideoDemos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="150dp"
                                android:adjustViewBounds="true"
                                android:layout_margin="20dp" />

                            <TextView
                                android:id="@+id/tvInstrucciones"
                                style="@style/Texto_Instrucciones"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="20dp" />
                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>


        </ScrollView>
        <Button
            android:id="@+id/btnAgregar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/Form_Button_Flotante_texto"
            android:layout_width="wrap_content"
            android:layout_margin="15dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/agregar_ejercicio" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>