<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.DiaEntrenamientoFragment">

    <LinearLayout
        style="@style/Layout_Main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <!-- Encabezado del día -->
        <TextView
            android:id="@+id/tvDia"
            style="@style/Texto_Titulo_Pantalla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Martes" />

        <!-- Tarjeta con información de la rutina -->

        <LinearLayout
            android:id="@+id/ltCardRutina"
            android:visibility="gone"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <com.google.android.material.card.MaterialCardView
                style="@style/Card_Rutina_Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    style="@style/Layout_Card_Rutina"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Nombre de la rutina -->
                    <TextView
                        android:id="@+id/tvRutina"
                        style="@style/Texto_Titulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:gravity="start"
                        android:text="Hit explosivo de pecho y espalda" />

                    <!-- Información de la rutina -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Zona muscular -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/contenedorParteAnatomica"
                            style="@style/Layout_Estado_Dia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/terciario"
                            android:padding="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvParteAnatomica"
                                style="@style/Texto_estado_dia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:layout_marginVertical="5dp"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Cantidad de ejercicios -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/contenedorCantidadEjercicios"
                            style="@style/Layout_Estado_Dia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/terciario"
                            android:padding="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvCantidadEjercicios"
                                style="@style/Texto_estado_dia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:layout_marginVertical="5dp"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Acciones fuera de la tarjeta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <!-- Acción principal -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIniciarEntrenamiento"
                    style="@style/Form_Button_Incio_Entrenamiento"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="3dp"
                    android:text="@string/iniciar_entrenamiento"
                    app:cornerRadius="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp" />

                <!-- Acción secundaria -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEliminar"
                    style="@style/Form_Button_Eliminar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="0dp"
                    android:text="@string/eliminar"
                    app:cornerRadius="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:id="@+id/ltSinRutina"
            android:visibility="gone"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:gravity="center"
                android:id="@+id/ltAgregarRutina"
                android:orientation="vertical"
                android:layout_height="match_parent">

                <TextView
                    style="@style/Texto_Titulo_Pantalla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agregar_rutina" />

                <ImageView
                    android:src="@drawable/ic_add_box"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="30dp"
                    android:minHeight="90dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</FrameLayout>

