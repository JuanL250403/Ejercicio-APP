<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.DetalleEjercicioFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                style="@style/Layout_Main"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreEjercicio"
                    style="@style/Texto_Titulo_Pantalla"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/llContenedorDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ivEjercicio"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- COLUMNA IZQUIERDA (Series y Peso) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"

                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <!-- Bloque Series -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/series_layout" />
                            <TextView android:layout_width="wrap_content" android:id="@+id/tvSeries" android:layout_height="wrap_content" style="@style/Texto_Numero_Ejercicio_Card" android:text="4" />
                        </LinearLayout>

                        <!-- Bloque Peso -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/peso_layout" />
                            <TextView android:layout_width="wrap_content" android:id="@+id/tvPeso" android:layout_height="wrap_content" style="@style/Texto_Numero_Ejercicio_Card" android:text="80kg" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- COLUMNA DERECHA (Reps y Descanso) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <!-- Bloque Reps -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/repeticiones_layout" />
                            <TextView android:layout_width="wrap_content" android:id="@+id/tvReps" android:layout_height="wrap_content" style="@style/Texto_Numero_Ejercicio_Card" android:text="12" />
                        </LinearLayout>

                        <!-- Bloque Descanso -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/descanso_layout" />
                            <TextView android:layout_width="wrap_content" android:id="@+id/tvDescanso" android:layout_height="wrap_content" style="@style/Texto_Numero_Ejercicio_Card" android:text="90s" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Layout_Card_Instrucciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:minHeight="300dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.google.android.material.imageview.ShapeableImageView
                                app:shapeAppearanceOverlay="@style/Layout_img_redondeada"
                                android:id="@+id/ivVideoDemos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="150dp"
                                android:adjustViewBounds="true"
                                android:layout_margin="20dp" />

                            <TextView
                                android:id="@+id/tvInstrucciones"
                                style="@style/Texto_Instrucciones"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="20dp" />
                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>


        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>