<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.MainActivity">

    <LinearLayout
        android:id="@+id/cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Layout_Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="toolbar"
            app:titleTextAppearance="@style/Texto_Titulo_Cabecera" />
    </LinearLayout>


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/navBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ltCardTiempo"
        app:navGraph="@navigation/main_graph" />


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navBottom"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_menu" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Card_Cronometro"
        android:id="@+id/ltCardTiempo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="80dp"
        app:layout_constraintBottom_toTopOf="@id/navHostFragment"
        app:layout_constraintTop_toBottomOf="@id/cabecera">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:orientation="horizontal"
            android:padding="15dp">

            <TextView
                style="@style/Texto_Titulo_Card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="center"
                android:id="@+id/tvRutinaDia"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="Haciendo rutina de prueba" />

            <Chronometer
                app:layout_constraintStart_toStartOf="parent"
                android:textSize="25dp"
                android:text="15"
                android:id="@+id/crTiempo"

                android:textAlignment="gravity"
                android:gravity="center"
                android:layout_width="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRutinaDia"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEstado"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/Form_Button_Estado"
                android:gravity="center"
                android:layout_height="match_parent"
                app:icon="@drawable/ic_pause" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:background="#14FFFFFF"
        android:id="@+id/ltCargando"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp">

        <ImageView
            android:id="@+id/imCargando"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@drawable/cargando"
            app:tint="@color/white" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>